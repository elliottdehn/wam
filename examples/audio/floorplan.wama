# "Floorplan" — four on the floor.
#
# The kick is on every beat for four minutes and that is not the boring part,
# it is the floor the rest is measured against. Everything else is placed
# against it by where it is *not*: the open hat on every offbeat, the bass in
# the gaps between kicks, the stabs late. That push-pull is the genre.
#
# Repetition here is the form rather than a failure of one. The parts barely
# change; what changes is how many of them there are and how open the filter
# is. `cut=500->9000` on the arp opens it across the whole track, which is the
# build every dance record is made of and which this language could not say
# until now.
#
#   bars   1-16   kick and hats, filtered down
#   bars  17-32   bass arrives; the filter starts opening
#   bars  33-64   DROP — stabs, arp, everything
#   bars  65-80   break — kick out, pads only
#   bars  81-96   build back
#   bars  97-128  DROP — and it stays there
audio floorplan
  key a minor
  tempo 126
  master -1.5

tones
  tone organ from=hollow tilt=1.15 harm=1.3
  tone rubber from=warm tilt=1.3 harm=1.1 spread=7
  tone glassy from=bright tilt=1.05 harm=1.35

instruments
  instrument bass  source=saw   tone=rubber env=gate  level=100% drive=soft
  instrument stab  source=saw   tone=organ  env=stab  level=100% space=room
  instrument pad   source=drone tone=rubber env=pad   level=100% space=hall
  instrument arp   source=saw   tone=glassy env=pluck level=100% space=hall
  instrument chord source=drone tone=organ  env=stab  level=100% space=room

song floorplan
  meter 4/4
  bars 128
  feel straight
  space room

  # --- the floor --------------------------------------------------------
  staff drum instrument=kit level=42%
    voice kick
      phrase FOUR
        | k4 k4 k4 k4
        | k4 k4 k4 k4
        | k4 k4 k4 k4
        | k4 k4 k4 k4
        | k4 k4 k4 k4
        | k4 k4 k4 k4
        | k4 k4 k4 k4
        | k4 k4 k4 k4
      phrase REST
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
      dynamic mf
      play FOUR FOUR
      dynamic f
      play FOUR FOUR
      dynamic ff
      play FOUR FOUR FOUR FOUR
      dynamic p
      play REST REST
      dynamic f
      play FOUR FOUR
      dynamic ff
      play FOUR FOUR FOUR FOUR

    voice clap
      phrase BACK
        | r4 s4 r4 s4
        | r4 s4 r4 s4
        | r4 s4 r4 s4
        | r4 s4 r4 s4
        | r4 s4 r4 s4
        | r4 s4 r4 s4
        | r4 s4 r4 s4
        | r4 s4 r4 s8 s8
      phrase REST
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
      dynamic p
      play REST
      dynamic mf
      play BACK
      dynamic f
      play BACK BACK
      dynamic ff
      play BACK BACK BACK BACK
      dynamic p
      play REST REST
      dynamic f
      play BACK BACK
      dynamic ff
      play BACK BACK BACK BACK

    # The open hat on every offbeat: the other half of four on the floor.
    voice ohat
      phrase OFF
        | r8 H8 r8 H8 r8 H8 r8 H8
        | r8 H8 r8 H8 r8 H8 r8 H8
        | r8 H8 r8 H8 r8 H8 r8 H8
        | r8 H8 r8 H8 r8 H8 r8 H8
        | r8 H8 r8 H8 r8 H8 r8 H8
        | r8 H8 r8 H8 r8 H8 r8 H8
        | r8 H8 r8 H8 r8 H8 r8 H8
        | r8 H8 r8 H8 r8 H8 r8 H8
      phrase REST
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
      dynamic mp
      play OFF OFF
      dynamic mf
      play OFF OFF
      dynamic f
      play OFF OFF OFF OFF
      dynamic p
      play REST REST
      dynamic mf
      play OFF OFF
      dynamic f
      play OFF OFF OFF OFF

    voice chat
      phrase SIX
        | h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16
        | h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16
        | h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16
        | h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16
        | h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16
        | h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16
        | h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16 h16
        | h16 h16 h16 h16 h16 h16 h16 h16 t16 t16 t16 t16 T16 T16 T16 T16
      phrase REST
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
      dynamic p
      play SIX SIX
      dynamic mp
      play SIX SIX
      dynamic mf
      play SIX SIX SIX SIX
      dynamic p
      play REST REST
      dynamic mp
      play SIX SIX
      dynamic mf
      play SIX SIX SIX SIX

  # --- the bass lives in the gaps between the kicks ---------------------
  staff bass instrument=bass level=52%
    voice line
      phrase REST
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
      phrase OFFBEAT
        | r8 a,8 r8 a,8 r8 a,8 r8 a,8
        | r8 a,8 r8 a,8 r8 a,8 r8 a,8
        | r8 f,8 r8 f,8 r8 f,8 r8 f,8
        | r8 f,8 r8 f,8 r8 f,8 r8 f,8
        | r8 c,8 r8 c,8 r8 c,8 r8 c,8
        | r8 c,8 r8 c,8 r8 c,8 r8 c,8
        | r8 g,8 r8 g,8 r8 g,8 r8 g,8
        | r8 g,8 r8 g,8 r8 g,8 g,8 a,8
      dynamic mp
      play REST REST
      dynamic mf
      play OFFBEAT OFFBEAT
      dynamic ff
      play OFFBEAT OFFBEAT OFFBEAT OFFBEAT
      dynamic p
      play REST REST
      dynamic mf
      play OFFBEAT OFFBEAT
      dynamic ff
      play OFFBEAT OFFBEAT OFFBEAT OFFBEAT

  # --- stabs, late, where the beat is not --------------------------------
  staff stab instrument=stab level=34% pan=-20%
    voice chords
      phrase REST
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
      phrase PUSH
        | r8 <a c' e'>8 r8 <a c' e'>8 r4 <a c' e'>8 r8
        | r8 <a c' e'>8 r8 <a c' e'>8 r4 <a c' e'>8 r8
        | r8 <f a c'>8 r8 <f a c'>8 r4 <f a c'>8 r8
        | r8 <f a c'>8 r8 <f a c'>8 r4 <f a c'>8 r8
        | r8 <c' e' g'>8 r8 <c' e' g'>8 r4 <c' e' g'>8 r8
        | r8 <c' e' g'>8 r8 <c' e' g'>8 r4 <c' e' g'>8 r8
        | r8 <g b d'>8 r8 <g b d'>8 r4 <g b d'>8 r8
        | r8 <g b d'>8 r8 <g b d'>8 <g b d'>8 r8 <a c' e'>4
      dynamic mp
      play REST REST REST REST
      dynamic ff
      play PUSH PUSH PUSH PUSH
      dynamic mp
      play REST REST
      play PUSH PUSH
      dynamic ff
      play PUSH PUSH PUSH PUSH

  # --- and the thing that actually builds: a filter opening -------------
  staff arp instrument=arp level=32% pan=25% cut=320->12000 curve=ease
    voice figure
      phrase RUN
        | a8 c'8 e'8 c'8 a8 c'8 e'8 c'8
        | a8 c'8 e'8 c'8 a8 c'8 e'8 c'8
        | f8 a8 c'8 a8 f8 a8 c'8 a8
        | f8 a8 c'8 a8 f8 a8 c'8 a8
        | c'8 e'8 g'8 e'8 c'8 e'8 g'8 e'8
        | c'8 e'8 g'8 e'8 c'8 e'8 g'8 e'8
        | g8 b8 d'8 b8 g8 b8 d'8 b8
        | g8 b8 d'8 b8 g8 b8 d'8 e'8
      dynamic mp
      play RUN RUN RUN RUN
      dynamic f
      play RUN RUN RUN RUN
      dynamic mf
      play RUN RUN RUN RUN
      dynamic ff
      play RUN RUN RUN RUN

  staff pad instrument=pad level=26% octave=-1
    voice hold
      phrase HOLD
        | <a, e>1
        | <a, e>1
        | <f, c>1
        | <f, c>1
        | <c, g>1
        | <c, g>1
        | <g,, d>1
        | <g,, d>1
      dynamic p
      play HOLD HOLD
      dynamic mp
      play HOLD HOLD
      play HOLD HOLD HOLD HOLD
      dynamic mf
      play HOLD HOLD
      dynamic mp
      play HOLD HOLD
      play HOLD HOLD HOLD HOLD

  checks
    assert peak <= -1.0 db
    assert duration ~ 244 s
    assert centroid < 4000 hz
