# "Hammer and Tongs" — piano and drums, and not much else.
#
# Piano and drums, both recorded rather than modelled: a sampled grand and a
# sampled acoustic kit, played from banks under samples/.
#
# The piano is the sampled bank, written the way piano music is actually
# written: two voices on one staff, a left hand and a right hand. The left
# drives octaves in eighths and never stops; the right answers on the offbeats
# until the last third, when it gives up on stabs and just runs.
#
# i-VII-VI-V in A minor, descending, which is the most propulsive four bars in
# music. The V is a real E major — `gis` written against a key signature that
# has no sharps in it — so it pulls back to the top every time instead of
# sagging.
audio hammer_and_tongs
  key a minor
  tempo 138
  master -1.5

instruments
  instrument piano source=sample bank=../../samples/piano env=natural level=100% space=hall
  instrument bass  source=saw  tone=warm env=gate level=100% drive=soft
  instrument pad   source=drone tone=dark env=pad level=100% space=hall
  instrument kit   source=kit bank=../../samples/drums level=100%

song hammer_and_tongs
  meter 4/4
  bars 112
  feel straight
  space room

  staff piano instrument=piano level=44% humanize=light
    # --- left hand: the engine ---------------------------------------
    voice left
      phrase DRIVE
        | a,8 a,8 a8 a,8 a,8 a,8 a8 a,8
        | g,8 g,8 g8 g,8 g,8 g,8 g8 g,8
        | f,8 f,8 f8 f,8 f,8 f,8 f8 f,8
        | e,8 e,8 e8 e,8 e,8 e,8 e8 e,8
      phrase HALF
        | a,2 a2
        | g,2 g2
        | f,2 f2
        | e,2 e2
      phrase POUND
        | <a,, a,>8 q q q q q q q
        | <g,, g,>8 q q q q q q q
        | <f,, f,>8 q q q q q q q
        | <e,, e,>8 q q q q q q q
      phrase SYNC
        | a,8 r8 a8 a,8 r8 a,8 a8 r8
        | g,8 r8 g8 g,8 r8 g,8 g8 r8
        | f,8 r8 f8 f,8 r8 f,8 f8 r8
        | e,8 r8 e8 e,8 r8 e,8 e8 r8
      phrase CLIMB
        | a,8 e8 a8 e8 a,8 e8 a8 e8
        | g,8 d8 g8 d8 g,8 d8 g8 d8
        | f,8 c8 f8 c8 f,8 c8 f8 c8
        | e,8 b,8 e8 b,8 e,8 b,8 e8 b,8
      dynamic mp
      play HALF DRIVE SYNC DRIVE
      dynamic mf
      play DRIVE SYNC CLIMB DRIVE
      play DRIVE CLIMB SYNC DRIVE
      dynamic ff
      play POUND POUND CLIMB POUND
      dynamic mp
      play HALF SYNC DRIVE CLIMB
      dynamic mf
      play DRIVE SYNC DRIVE CLIMB
      dynamic ff
      play POUND CLIMB POUND POUND

    # --- right hand: stabs, then it stops holding back ----------------
    voice right
      phrase REST
        | r1
        | r1
        | r1
        | r1
      phrase STAB
        | r8 <a c' e'>8 r8 <a c' e'>8 r8 <a c' e'>8 <a c' e'>8 r8
        | r8 <g b d'>8 r8 <g b d'>8 r8 <g b d'>8 <g b d'>8 r8
        | r8 <f a c'>8 r8 <f a c'>8 r8 <f a c'>8 <f a c'>8 r8
        | r8 <e gis b>8 r8 <e gis b>8 r8 <e gis b>8 <e gis b>8 r8
      phrase RUN
        | a8 c'8 e'8 a'8 e'8 c'8 a8 c'8
        | g8 b8 d'8 g'8 d'8 b8 g8 b8
        | f8 a8 c'8 f'8 c'8 a8 f8 a8
        | e8 gis8 b8 e'8 b8 gis8 e8 gis8
      phrase HIGH
        | a'8 c''8 e''8 a''8 e''8 c''8 a'8 c''8
        | g'8 b'8 d''8 g''8 d''8 b'8 g'8 b'8
        | f'8 a'8 c''8 f''8 c''8 a'8 f'8 a'8
        | e'8 gis'8 b'8 e''8 b'8 gis'8 e'8 gis'8
      phrase FALL
        | a'8 e'8 c'8 a8 c'8 e'8 a'8 e'8
        | g'8 d'8 b8 g8 b8 d'8 g'8 d'8
        | f'8 c'8 a8 f8 a8 c'8 f'8 c'8
        | e'8 b8 gis8 e8 gis8 b8 e'8 b8
      phrase BLOCK
        | <a c' e'>4 q4 q4 q4
        | <g b d'>4 q4 q4 q4
        | <f a c'>4 q4 q4 q4
        | <e gis b>4 q4 q2
      dynamic mp
      play REST REST STAB BLOCK
      dynamic mf
      play STAB BLOCK RUN FALL
      play RUN FALL HIGH RUN
      dynamic ff
      play HIGH FALL HIGH BLOCK
      dynamic mp
      play REST STAB BLOCK STAB
      dynamic mf
      play RUN FALL RUN HIGH
      dynamic ff
      play HIGH FALL HIGH BLOCK

  staff bass instrument=bass level=40% octave=-1
    voice line
      phrase REST
        | r1
        | r1
        | r1
        | r1
      phrase ROOT
        | a,4 r4 a,4 r4
        | g,4 r4 g,4 r4
        | f,4 r4 f,4 r4
        | e,4 r4 e,8 e,8 r4
      phrase DRIVEN
        | a,8 q q q q q q q
        | g,8 q q q q q q q
        | f,8 q q q q q q q
        | e,8 q q q e,8 q e,8 q
      play REST REST REST REST
      dynamic mf
      play ROOT ROOT DRIVEN DRIVEN
      dynamic ff
      play DRIVEN DRIVEN DRIVEN DRIVEN
      dynamic p
      play REST REST ROOT ROOT
      dynamic mf
      play DRIVEN DRIVEN DRIVEN DRIVEN
      dynamic ff
      play DRIVEN DRIVEN DRIVEN DRIVEN
      dynamic mf
      play DRIVEN ROOT REST REST

  staff pad instrument=pad level=18% octave=-1
    voice hold
      phrase HOLD
        | <a, e>1
        | <g,, d>1
        | <f,, c>1
        | <e,, b,>1
      dynamic p
      play HOLD HOLD HOLD HOLD
      dynamic mp
      play HOLD HOLD HOLD HOLD
      dynamic p
      play HOLD HOLD HOLD HOLD
      dynamic mp
      play HOLD HOLD HOLD HOLD
      play HOLD HOLD HOLD HOLD
      dynamic mf
      play HOLD HOLD HOLD HOLD
      play HOLD HOLD HOLD HOLD

  staff drum instrument=kit level=44%
    voice kick
      phrase REST
        | r1
        | r1
        | r1
        | r1
      phrase PULSE
        | k4 r4 k4 r4
        | k4 r4 k4 r4
        | k4 r4 k4 r4
        | k4 r4 k8 k8 r4
      phrase DRIVE
        | k8 r8 r8 k8 r8 r8 k8 r8
        | k8 r8 r8 k8 r8 r8 k8 r8
        | k8 r8 r8 k8 r8 r8 k8 r8
        | k8 r8 k8 k8 r8 k8 k8 r8
      phrase FOUR
        | k4 k4 k4 k4
        | k4 k4 k4 k4
        | k4 k4 k4 k4
        | k4 k4 k8 k8 k4
      play REST REST
      dynamic mf
      play PULSE PULSE
      play DRIVE DRIVE DRIVE DRIVE
      dynamic ff
      play FOUR FOUR FOUR FOUR
      dynamic mp
      play REST PULSE PULSE DRIVE
      dynamic mf
      play DRIVE DRIVE DRIVE DRIVE
      dynamic ff
      play FOUR FOUR FOUR FOUR
      dynamic mf
      play DRIVE PULSE REST REST

    voice snare
      phrase REST
        | r1
        | r1
        | r1
        | r1
      phrase BACK
        | r4 s4 r4 s4
        | r4 s4 r4 s4
        | r4 s4 r4 s4
        | r4 s4 r4 s8 s8
      phrase FILL
        | r4 s4 r4 s4
        | r4 s4 r4 s4
        | r4 s4 r4 s4
        | s8 s8 t8 t8 T8 T8 s8 c8
      play REST REST
      dynamic mf
      play BACK BACK
      play BACK BACK BACK FILL
      dynamic ff
      play BACK BACK BACK FILL
      dynamic mp
      play REST BACK BACK BACK
      dynamic mf
      play BACK BACK BACK FILL
      dynamic ff
      play BACK BACK BACK FILL
      dynamic mf
      play BACK FILL REST REST

    voice hats
      phrase REST
        | r1
        | r1
        | r1
        | r1
      phrase EIGHTHS
        | h8 h8 h8 h8 h8 h8 h8 h8
        | h8 h8 h8 h8 h8 h8 h8 h8
        | h8 h8 h8 h8 h8 h8 h8 h8
        | h8 h8 h8 h8 h8 h8 h8 h8
      phrase OPEN
        | h8 H8 h8 H8 h8 H8 h8 H8
        | h8 H8 h8 H8 h8 H8 h8 H8
        | h8 H8 h8 H8 h8 H8 h8 H8
        | h8 H8 h8 H8 h8 h8 h8 h8
      dynamic p
      play REST EIGHTHS
      dynamic mp
      play EIGHTHS EIGHTHS
      dynamic mf
      play EIGHTHS EIGHTHS EIGHTHS EIGHTHS
      dynamic ff
      play OPEN OPEN OPEN OPEN
      dynamic mp
      play REST EIGHTHS EIGHTHS EIGHTHS
      dynamic mf
      play EIGHTHS EIGHTHS EIGHTHS EIGHTHS
      dynamic ff
      play OPEN OPEN OPEN OPEN
      dynamic mf
      play EIGHTHS EIGHTHS REST REST

  checks
    assert peak <= -1.0 db
    assert duration ~ 195 s
    assert centroid < 4000 hz
