# "Ninety Seconds" — a cue for a 90-second cinematic.
#
# Written to a clock rather than to a loop. At 80 in 4/4 a bar is exactly
# three seconds, so thirty bars is ninety seconds and every bar is one
# countable beat of screen time:
#
#   bar  1  0:00   establish — one voice over a low drone, nothing moving
#   bar  6  0:15   a pulse arrives, and the strings take a breath
#   bar 11  0:30   the ostinato starts; from here it does not stop
#   bar 16  0:45   brass, and the first real hit
#   bar 21  1:00   climax
#   bar 26  1:15   aftermath — everything falls away but the opening motif
#   bar 31  1:30   out
#
# `loop off`, so it ends rather than coming round again, and the last chord is
# allowed to ring past the final bar into the cut.
#
# The motif is four notes and it is the only melodic idea in the piece. It is
# stated alone at 0:00, buried under the ostinato at 0:30, shouted by the brass
# at 1:00, and left alone again at 1:15. That is the whole cue.
audio ninety_seconds
  key d minor
  tempo 80
  master -1.5

tones
  tone bowed from=warm tilt=1.4 harm=0.9 spread=8
  tone brassy from=harsh tilt=1.1 harm=1.5 spread=5
  tone murk from=dark tilt=2.3
  tone glassy from=bright tilt=1.1 harm=1.2

instruments
  instrument low     source=drone  tone=murk   env=pad   level=100% space=cave
  instrument strings source=bow    tone=bowed  env=bow   level=100% space=hall
  instrument brass   source=saw    tone=brassy env=stab  level=100% drive=soft space=hall
  instrument motif   source=bow    tone=bowed  env=bow   level=100% space=hall
  instrument ost     source=pluck  tone=glassy env=pluck level=100% damp=0.45 space=hall
  instrument chime   source=bell   tone=glassy env=pluck level=100% space=hall

song ninety_seconds
  meter 4/4
  bars 30
  feel straight
  loop off
  space hall

  # --- the drone under all ninety seconds -------------------------------
  staff low instrument=low level=34% octave=-1
    voice pedal
      phrase HOLD
        | <d, a,>1
        | <d, a,>1
        | <d, a,>1
        | <bes,, f,>1
        | <a,, e,>1
      dynamic p
      play HOLD
      dynamic mp
      play HOLD
      dynamic mf
      play HOLD
      dynamic f
      play HOLD
      dynamic ff
      play HOLD
      dynamic mp
      play HOLD

  # --- four notes, and nothing else melodic happens ---------------------
  staff motif instrument=motif level=48% pan=-20% humanize=light
    voice tune
      phrase STATE
        | r1
        | r2 d'2
        | f'2 e'2
        | d'1
        | r1
      phrase BURIED
        | r1
        | r1
        | r2 d'2
        | f'2 e'2
        | d'1
      phrase REST
        | r1
        | r1
        | r1
        | r1
        | r1
      phrase ALONE
        | r2 d'2
        | f'2 e'2
        | d'1
        | a2. r4
        | d'1
      dynamic mp
      play STATE
      dynamic p
      play REST
      dynamic mf
      play BURIED
      dynamic mp
      play REST
      dynamic ff
      play BURIED
      dynamic mp
      play ALONE

  staff strings instrument=strings level=40% pan=15% humanize=light
    voice upper
      phrase REST
        | r1
        | r1
        | r1
        | r1
        | r1
      phrase BREATH
        | a'1
        | a'1
        | d''1
        | d''1
        | c''1
      phrase RISE
        | d''1
        | e''1
        | f''1
        | f''1
        | e''1
      phrase HIGH
        | a''1
        | a''1
        | f''1
        | d''1
        | e''1
      play REST
      dynamic mp
      play BREATH
      dynamic mf
      play RISE
      dynamic f
      play RISE
      dynamic ff
      play HIGH
      dynamic p
      play BREATH

    voice lower
      phrase REST
        | r1
        | r1
        | r1
        | r1
        | r1
      phrase BREATH
        | d'1
        | d'1
        | a'1
        | a'1
        | a'1
      phrase RISE
        | f'1
        | g'1
        | a'1
        | a'1
        | a'1
      play REST
      dynamic mp
      play BREATH
      dynamic mf
      play RISE
      dynamic f
      play RISE
      dynamic ff
      play RISE
      dynamic p
      play BREATH

  # --- from 0:30 it never stops -----------------------------------------
  staff ost instrument=ost level=34% pan=-25% humanize=light
    voice figure
      phrase REST
        | r1
        | r1
        | r1
        | r1
        | r1
      phrase RUN
        | d'8 a'8 d''8 a'8 d'8 a'8 d''8 a'8
        | d'8 a'8 d''8 a'8 d'8 a'8 d''8 a'8
        | d'8 f'8 a'8 f'8 d'8 f'8 a'8 f'8
        | bes8 f'8 bes'8 f'8 bes8 f'8 bes'8 f'8
        | a8 e'8 a'8 e'8 a8 c''8 a'8 e'8
      dynamic mp
      play REST REST
      play RUN
      dynamic mf
      play RUN
      dynamic ff
      play RUN
      dynamic p
      play REST

  # --- the brass says the motif once, at the top ------------------------
  staff brass instrument=brass level=44% pan=25%
    voice line
      phrase REST
        | r1
        | r1
        | r1
        | r1
        | r1
      phrase HIT
        | r1
        | r1
        | r1
        | d'2 r2
        | d'1
      phrase SHOUT
        | r2 d''2
        | f''2 e''2
        | d''1
        | bes'2 a'2
        | d''1
      play REST REST REST
      dynamic f
      play HIT
      dynamic ff
      play SHOUT
      dynamic mp
      play REST

  staff chime instrument=chime level=30% pan=30%
    voice toll
      phrase REST
        | r1
        | r1
        | r1
        | r1
        | r1
      phrase MARK
        | d'''1
        | r1
        | r1
        | r1
        | r1
      phrase LAST
        | r1
        | r1
        | d'''1
        | r1
        | a''1
      dynamic mf
      play MARK
      dynamic p
      play REST
      dynamic mp
      play MARK
      dynamic f
      play MARK
      dynamic ff
      play MARK
      dynamic mp
      play LAST

  # --- a pulse, then hits, then nothing ---------------------------------
  staff perc instrument=kit level=46%
    voice beat
      phrase REST
        | r1
        | r1
        | r1
        | r1
        | r1
      phrase PULSE
        | T2 r2
        | T2 r2
        | T2 r2
        | T2 r2
        | T4 T4 r2
      phrase DRIVE
        | k4 r4 k4 r4
        | k4 r4 k4 r4
        | k4 r4 k4 r4
        | k4 k4 k4 r4
        | k4 r4 t8 t8 T8 T8
      phrase FULL
        | c4 r4 k4 r4
        | k4 r4 k4 s4
        | k4 r4 k4 r4
        | k4 k4 s4 s4
        | t8 t8 T8 T8 s8 s8 c4
      dynamic p
      play REST
      dynamic mp
      play PULSE
      dynamic mf
      play PULSE
      dynamic f
      play DRIVE
      dynamic ff
      play FULL
      dynamic p
      play REST

  checks
    assert peak <= -1.0 db
    assert duration > 90 s
    assert centroid < 3000 hz
