# Main menu theme, written as a score.
#
# The key signature does real work: in D major every written `f` and `c`
# sounds sharp, so `<d' f' a'>` means D-F#-A. That is what a player reads off
# a staff, and transposing the piece is one line rather than every note.
#
# Four eight-bar cycles, and they are not the same cycle four times:
#
#   1-8    the question. Strings and a call answered two bars later.
#   9-16   the floor arrives: bass, harp, and a drum that starts as a pulse.
#   17-24  the payoff. The lead stops trading and plays straight through,
#          high, over a crash and a driving kit.
#   25-32  the release, thinning back to what bar 1 sounded like so the loop
#          rejoins itself.
#
# The harmony is eight bars, not four, so the cycle does not close where the
# ear expects: bars 7-8 turn to Em and A7 instead of repeating G-A.
audio menu
  key d major
  tempo 96
  master -1.5

tones
  # `bright` unmodified is reedy; the lead has to carry without turning into
  # a kazoo.
  tone bright harm=1.15 tilt=1.15
  tone answering from=warm tilt=1.35 harm=0.85

instruments
  instrument lead    source=bow   tone=bright    env=bow   level=100% space=hall
  instrument reply   source=bow   tone=answering env=bow   level=100% space=hall
  instrument strings source=drone tone=warm      env=pad   level=100% space=hall
  instrument harp    source=pluck tone=bright    env=pluck level=100% damp=0.5 space=room
  instrument bass    source=pluck tone=warm      env=pluck level=100% damp=0.4

song main_theme
  meter 4/4
  bars 32
  feel straight
  space hall

  # --- the call, and in the payoff the whole tune -----------------------
  staff lead instrument=lead level=52% pan=-30% humanize=light
    voice tune
      phrase CALL1
        | a'4 d''4 f''2
        | e''4 d''4 b'2
      phrase CALL2
        | f''4 e''4 d''4 a'4
        | b'4 d''4 f''2
      phrase SILENT
        | r1
        | r1
      phrase P1
        | f''4 a''4 f''4 d''4
        | e''2 d''2
      phrase P2
        | d''4 f''4 a''4 b''4
        | a''2 f''2
      phrase P3
        | g''4 f''4 e''4 d''4
        | c''4 e''4 a'2
      phrase P4
        | g'4 b'4 e''4 g''4
        | a''2 e''2
      dynamic p
      play CALL1 SILENT CALL2 SILENT
      dynamic mp
      play CALL1 SILENT CALL2 SILENT
      dynamic ff
      play P1 P2 P3 P4
      dynamic mp
      play CALL1 SILENT CALL2 SILENT

  # --- the answer: two bars later, lower, other ear ---------------------
  staff reply instrument=reply level=44% pan=30% octave=-1 humanize=light
    voice tune
      phrase ANSWER1
        | d''4 b'4 g'2
        | c''4 a'4 e'2
      phrase ANSWER2
        | g'4 b'4 e''2
        | c''4 e''4 a'2
      phrase SILENT
        | r1
        | r1
      dynamic p
      play SILENT ANSWER1 SILENT ANSWER2
      dynamic mp
      play SILENT ANSWER1 SILENT ANSWER2
      play SILENT SILENT SILENT SILENT
      dynamic mp
      play SILENT ANSWER1 SILENT ANSWER2

  # --- the harmony, all the way through --------------------------------
  staff strings instrument=strings level=30% octave=-1
    voice chords
      phrase CHORDS
        | <d' f' a'>1
        | <b d' f'>1
        | <g b d'>1
        | <a c' e'>1
        | <d' f' a'>1
        | <b d' f'>1
        | <e g b>1
        | <a c' e' g'>1
      dynamic p
      play CHORDS
      dynamic mp
      play CHORDS
      dynamic f
      play CHORDS
      dynamic mp
      play CHORDS

  # --- the floor, from bar 9 -------------------------------------------
  staff bass instrument=bass level=62% octave=-1
    voice line
      phrase SILENT
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
      phrase WALK
        | d4 r4 a,4 r4
        | b,4 r4 f,4 r4
        | g,4 r4 d4 r4
        | a,4 r4 e4 r4
        | d4 r4 a,4 r4
        | b,4 r4 f,4 r4
        | e4 r4 b,4 r4
        | a,4 r4 e4 r4
      phrase DRIVEN
        | d8 d8 a,8 a,8 d8 d8 a,8 a,8
        | b,8 b,8 f,8 f,8 b,8 b,8 f,8 f,8
        | g,8 g,8 d8 d8 g,8 g,8 d8 d8
        | a,8 a,8 e8 e8 a,8 a,8 e8 e8
        | d8 d8 a,8 a,8 d8 d8 a,8 a,8
        | b,8 b,8 f,8 f,8 b,8 b,8 f,8 f,8
        | e8 e8 b,8 b,8 e8 e8 b,8 b,8
        | a,8 a,8 e8 e8 a,8 a,8 g8 g8
      play SILENT
      dynamic mp
      play WALK
      dynamic ff
      play DRIVEN
      dynamic mp
      play WALK

  staff harp instrument=harp level=34% pan=-20% humanize=light
    voice figure
      phrase SILENT
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
      phrase ARP
        | d'8 f'8 a'8 f'8 d'8 f'8 a'8 f'8
        | b8 d'8 f'8 d'8 b8 d'8 f'8 d'8
        | g8 b8 d'8 b8 g8 b8 d'8 b8
        | a8 c'8 e'8 c'8 a8 c'8 e'8 c'8
        | d'8 f'8 a'8 f'8 d'8 f'8 a'8 f'8
        | b8 d'8 f'8 d'8 b8 d'8 f'8 d'8
        | e8 g8 b8 g8 e8 g8 b8 g8
        | a8 c'8 e'8 g'8 e'8 c'8 a8 c'8
      phrase ARPHIGH
        | d''8 f''8 a''8 f''8 d''8 f''8 a''8 f''8
        | b'8 d''8 f''8 d''8 b'8 d''8 f''8 d''8
        | g'8 b'8 d''8 b'8 g'8 b'8 d''8 b'8
        | a'8 c''8 e''8 c''8 a'8 c''8 e''8 c''8
        | d''8 f''8 a''8 f''8 d''8 f''8 a''8 f''8
        | b'8 d''8 f''8 d''8 b'8 d''8 f''8 d''8
        | e'8 g'8 b'8 g'8 e'8 g'8 b'8 g'8
        | a'8 c''8 e''8 g''8 e''8 c''8 a'8 c''8
      play SILENT
      dynamic mp
      play ARP
      dynamic ff
      play ARPHIGH
      dynamic p
      play ARP

  # --- percussion: a pulse, then a kit, then a fill into the payoff ----
  staff drum instrument=kit level=58% humanize=light
    voice beat
      phrase SILENT
        | r1
        | r1
      phrase PULSE
        | k2 k2
        | k2 k4 r4
      phrase STEADY
        | k8 h8 s8 h8 k8 h8 s8 h8
        | k8 h8 s8 h8 k8 s8 h8 h8
      phrase DRIVE
        | c8 h8 s8 h8 k8 h8 s8 h8
        | k8 h8 s8 h8 k8 s8 h8 h8
      phrase FILL
        | k8 h8 s8 h8 k8 h8 s8 h8
        | t8 t8 T8 T8 s8 s8 s8 c8
      play SILENT SILENT SILENT SILENT
      dynamic mp
      play PULSE PULSE STEADY FILL
      dynamic ff
      play DRIVE STEADY DRIVE FILL
      dynamic mp
      play STEADY STEADY PULSE SILENT

  checks
    assert peak <= -1.0 db
    assert duration ~ 80.0 s
    assert centroid < 3000 hz
    assert loop_pop < 14 db
