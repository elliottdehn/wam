# ALIEN GOD, track 10 — "Ashfall"
#
# After. The only track on the record with `loop off`, because a closer that
# comes round again is not a closer — this one is allowed to decay into
# silence and stay there. A minor, no accidentals at all: the alien intervals
# that ran through everything else are simply gone, and what is left is plain.
audio ashfall
  key a minor
  tempo 54
  master -1.5

tones
  tone murk from=dark tilt=2.4
  tone alien from=hollow tilt=1.5 harm=0.8
  tone glass from=bright harm=1.1 tilt=1.3

instruments
  instrument monolith source=drone  tone=murk  env=pad   level=100% space=cave
  instrument vox      source=drone  tone=alien env=swell level=100% space=cave
  instrument harp     source=pluck  tone=glass env=pluck level=100% damp=0.35 space=hall
  instrument bell     source=bell   tone=dark  env=pluck level=100% space=cave
  instrument air      source=breath tone=alien env=swell level=100% space=cave
  instrument bass     source=pluck  tone=murk  env=pluck level=100% damp=0.4

song ashfall
  meter 4/4
  bars 56
  feel straight
  loop off
  space cave

  staff monolith instrument=monolith level=32%
    voice pedal
      phrase HOLD
        | <a, e>1~
        | q1~
        | q1~
        | q1~
        | <f, c>1~
        | q1~
        | <a, e>1~
        | q1~
      dynamic mf
      play HOLD HOLD
      dynamic mp
      play HOLD HOLD
      dynamic p
      play HOLD HOLD
      dynamic pp
      play HOLD

  staff bell instrument=bell level=34% pan=-30%
    voice toll
      phrase TOLL
        | a''1
        | r1
        | r1
        | r1
        | e''1
        | r1
        | r1
        | r1
      phrase LAST
        | a''1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
      dynamic mf
      play TOLL TOLL
      dynamic mp
      play TOLL TOLL
      dynamic p
      play TOLL LAST
      dynamic pp
      play LAST

  staff harp instrument=harp level=32% pan=25%
    voice figure
      phrase SILENT
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
      phrase FALL
        | a'4 e'4 c'4 a4
        | r1
        | g'4 e'4 c'4 a4
        | r1
        | f'4 c'4 a4 f4
        | r1
        | e'4 c'4 a4 e4
        | r1
      phrase SPARSE
        | a'2. e'4
        | r1
        | c'2. a4
        | r1
        | r1
        | r1
        | a4 r4 r2
        | r1
      play SILENT
      dynamic mp
      play FALL FALL
      dynamic p
      play FALL SPARSE
      dynamic pp
      play SPARSE SPARSE

  staff vox instrument=vox level=28% pan=-20%
    voice choir
      phrase HOLD
        | <a' c'' e''>1~
        | q1~
        | q1~
        | q1~
        | <f' a' c''>1~
        | q1~
        | <a' c'' e''>1~
        | q1~
      phrase THIN
        | <a' e''>1~
        | q1~
        | q1~
        | q1~
        | <a' e''>1~
        | q1~
        | <a' e''>1~
        | q1~
      dynamic mp
      play HOLD HOLD
      dynamic mf
      play HOLD
      dynamic p
      play HOLD THIN
      dynamic pp
      play THIN THIN

  staff air instrument=air level=26% pan=30%
    voice breath
      phrase SILENT
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
      phrase DRIFT
        | r1
        | a'1
        | r1
        | c''1
        | r1
        | a'1
        | r1
        | e'1
      play SILENT SILENT
      dynamic mp
      play DRIFT DRIFT
      dynamic p
      play DRIFT DRIFT
      dynamic pp
      play DRIFT

  staff bass instrument=bass level=40% octave=-1
    voice line
      phrase SILENT
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
        | r1
      phrase ROOT
        | a,1
        | r1
        | r1
        | r1
        | f,1
        | r1
        | r1
        | r1
      play SILENT
      dynamic mp
      play ROOT ROOT ROOT
      dynamic p
      play ROOT ROOT
      dynamic pp
      play SILENT

  checks
    assert peak <= -1.0 db
    assert duration > 245 s
    assert centroid < 3000 hz
