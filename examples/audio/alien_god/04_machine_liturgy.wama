# ALIEN GOD, track 4 — "Machine Liturgy"
#
# Worship performed by something that does not tire. A harmonic minor puts G#
# in the signature against a natural F, and that augmented second between them
# is the oldest "not from here" interval there is — here it is played by a
# machine, exactly on the grid, forever. Nothing on this track is humanised.
audio machine_liturgy
  key a harmonic
  tempo 120
  master -1.5

tones
  tone grind from=harsh tilt=0.75 harm=1.9
  tone murk from=dark tilt=2.4
  tone alien from=hollow tilt=1.5 harm=0.8
  tone steel from=bright harm=1.6 tilt=0.9

instruments
  instrument monolith source=drone  tone=murk  env=pad   level=100% space=cave
  instrument engine   source=pulse  tone=grind env=gate  level=100% drive=fuzz
  instrument bass     source=saw    tone=murk  env=gate  level=100% drive=soft
  instrument lead     source=square tone=steel env=gate  level=100% drive=hard
  instrument anvil    source=metal  tone=steel env=hit   level=100% space=cave
  instrument vox      source=drone  tone=alien env=swell level=100% space=cave

song machine_liturgy
  meter 7/8
  bars 152
  feel straight
  space room

  staff monolith instrument=monolith level=28%
    voice pedal
      phrase HOLD
        | <a, e>2.~ q8
        | q2.~ q8
        | q2.~ q8
        | q2.~ q8
        | <f, c>2.~ q8
        | q2.~ q8
        | <a, e>2.~ q8
        | q2.~ q8
      dynamic mf
      play HOLD HOLD HOLD HOLD HOLD
      dynamic mp
      play HOLD HOLD HOLD HOLD HOLD
      dynamic p
      play HOLD HOLD HOLD HOLD
      dynamic mf
      play HOLD HOLD HOLD HOLD HOLD

  staff engine instrument=engine level=46% pan=-20%
    voice piston
      phrase RUN
        | a,8 q q q q q q
        | a,8 q q q q q q
        | a,8 q q q q q q
        | a,8 q q q c8 q q
        | a,8 q q q q q q
        | a,8 q q q q q q
        | f,8 q q q q q q
        | a,8 q q q gis8 q q
      phrase SILENT
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
      dynamic mp
      play RUN RUN
      dynamic mf
      play RUN RUN RUN RUN
      dynamic ff
      play RUN RUN RUN RUN
      dynamic p
      play SILENT SILENT
      dynamic ff
      play RUN RUN RUN RUN RUN
      dynamic mp
      play SILENT SILENT

  staff bass instrument=bass level=56%
    voice line
      phrase SILENT
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
      phrase PEDAL
        | a,4 r4 a,4 r8
        | a,4 r4 a,4 r8
        | a,4 r4 a,4 r8
        | a,4 a,4 a,4 r8
        | f,4 r4 f,4 r8
        | f,4 r4 f,4 r8
        | gis,4 r4 gis,4 r8
        | a,4 a,4 a,4 r8
      phrase GRIND
        | a,8 q q q q q q
        | a,8 q q q q q q
        | f,8 q q q q q q
        | gis,8 q q q a,8 q q
        | a,8 q q q q q q
        | a,8 q q q q q q
        | f,8 q q q gis,8 q q
        | a,8 q q q q q q
      play SILENT
      dynamic mp
      play PEDAL PEDAL
      dynamic mf
      play GRIND GRIND GRIND
      dynamic ff
      play GRIND GRIND GRIND GRIND
      dynamic p
      play PEDAL PEDAL
      dynamic ff
      play GRIND GRIND GRIND GRIND GRIND
      dynamic mp
      play PEDAL SILENT

  staff lead instrument=lead level=40% pan=25%
    voice line
      phrase SILENT
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
      phrase HYMN
        | a'4 c''4 e''4 r8
        | gis'4 a'4 c''4 r8
        | f'4 gis'4 a'4 r8
        | e'2. r8
        | a'4 c''4 e''4 r8
        | f''4 e''4 c''4 r8
        | gis'4 a'4 b'4 r8
        | a'2. r8
      phrase RUNNING
        | a'8 b'8 c''8 d''8 e''8 f''8 gis''8
        | a''8 gis''8 f''8 e''8 d''8 c''8 b'8
        | a'8 b'8 c''8 d''8 e''8 f''8 gis''8
        | a''2. r8
        | f''8 e''8 d''8 c''8 b'8 a'8 gis'8
        | a'8 b'8 c''8 d''8 e''8 f''8 e''8
        | d''8 c''8 b'8 a'8 gis'8 a'8 b'8
        | a'2. r8
      play SILENT SILENT SILENT
      dynamic mf
      play HYMN HYMN
      dynamic f
      play RUNNING RUNNING
      dynamic p
      play SILENT SILENT
      dynamic ff
      play RUNNING RUNNING HYMN HYMN
      play RUNNING
      dynamic mp
      play HYMN SILENT

  staff anvil instrument=anvil level=34% pan=35%
    voice strike
      phrase SILENT
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
      phrase HAMMER
        | a''4 r4 r4 r8
        | r2. r8
        | a''4 r4 r4 r8
        | r2. r8
        | f''4 r4 r4 r8
        | r2. r8
        | gis''4 r4 a''4 r8
        | r2. r8
      dynamic mf
      play HAMMER HAMMER
      dynamic mp
      play HAMMER HAMMER HAMMER HAMMER
      dynamic f
      play HAMMER HAMMER HAMMER HAMMER
      dynamic p
      play SILENT SILENT
      dynamic f
      play HAMMER HAMMER HAMMER HAMMER HAMMER
      play HAMMER HAMMER

  staff vox instrument=vox level=24% pan=-30%
    voice choir
      phrase SILENT
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
      phrase HOLD
        | <a' c'' e''>2.~ q8
        | q2.~ q8
        | q2.~ q8
        | q2.~ q8
        | <f' a' c''>2.~ q8
        | q2.~ q8
        | <gis' b' e''>2.~ q8
        | q2.~ q8
      play SILENT SILENT SILENT SILENT SILENT SILENT
      dynamic mp
      play HOLD HOLD HOLD
      dynamic p
      play SILENT SILENT
      dynamic mf
      play HOLD HOLD HOLD HOLD HOLD
      dynamic p
      play HOLD HOLD HOLD

  staff drum instrument=kit level=56%
    voice beat
      phrase SILENT
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
        | r2. r8
      phrase TICK
        | h8 r8 h8 r8 h8 r8 h8
        | h8 r8 h8 r8 h8 r8 h8
        | h8 r8 h8 r8 h8 r8 h8
        | h8 h8 h8 r8 h8 r8 h8
        | h8 r8 h8 r8 h8 r8 h8
        | h8 r8 h8 r8 h8 r8 h8
        | h8 r8 h8 r8 h8 r8 h8
        | h8 h8 h8 h8 h8 h8 h8
      phrase WORKS
        | k8 h8 s8 h8 k8 s8 h8
        | k8 h8 s8 h8 k8 s8 h8
        | k8 h8 s8 h8 k8 s8 h8
        | k8 k8 s8 h8 k8 s8 s8
        | k8 h8 s8 h8 k8 s8 h8
        | k8 h8 s8 h8 k8 s8 h8
        | k8 h8 s8 h8 k8 s8 h8
        | t8 t8 T8 T8 s8 s8 c8
      phrase FULL
        | c8 k8 s8 k8 k8 s8 h8
        | k8 h8 s8 k8 k8 s8 h8
        | k8 h8 s8 k8 k8 s8 h8
        | k8 k8 s8 k8 s8 s8 h8
        | c8 k8 s8 k8 k8 s8 h8
        | k8 h8 s8 k8 k8 s8 h8
        | k8 h8 s8 k8 k8 s8 h8
        | t8 t8 T8 T8 s8 s8 c8
      dynamic mp
      play TICK TICK
      dynamic mf
      play WORKS WORKS WORKS WORKS
      dynamic ff
      play FULL FULL FULL FULL
      dynamic p
      play TICK TICK
      dynamic ff
      play FULL FULL FULL FULL FULL
      dynamic mp
      play TICK SILENT

  checks
    assert peak <= -1.0 db
    assert duration ~ 266 s
    assert loop_pop < 14 db
    assert centroid < 4000 hz
