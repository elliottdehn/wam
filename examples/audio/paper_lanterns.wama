# "Paper Lanterns" — conventional pop.
#
# The form is the point, and it is the thing a loop cannot fake:
#
#   intro 8 · verse 8 · PRE 4 · CHORUS 8 · verse 8 · PRE 4 · CHORUS 8
#   · bridge 8 · drop 4 · CHORUS 12 · outro 8
#
# The harmony moves with it rather than under it. Verses and choruses are
# I-V-vi-IV in F; the pre-chorus is IV-V-vi-vi, which leans on the six and
# refuses to resolve until the chorus does it; the bridge is vi-iii-IV-V,
# starting somewhere the song has not been. A progression that never changes
# is the main reason a pop arrangement sounds like a loop.
#
# The kit is three voices on one staff, which is what makes a verse and a
# chorus different things rather than the same pattern at two volumes: the
# kick voice plays backbeat in verses and four-on-the-floor in choruses, and
# the hats open up over it.
#
# What is missing is the voice. There are no formants here and no words, so
# the hook is carried by a plucked lead where a singer would be.
audio paper_lanterns
  key f major
  tempo 112
  master -1.5

tones
  tone glassy from=bright tilt=1.05 harm=1.3
  tone soft from=warm tilt=1.6 harm=0.7 spread=6
  tone woody from=warm tilt=1.2 harm=0.95

instruments
  instrument keys source=pluck tone=woody  env=pluck level=100% damp=0.55 space=room
  instrument lead source=pluck tone=glassy env=pluck level=100% damp=0.35 space=hall
  instrument bass source=pluck tone=warm   env=gate  level=100% damp=0.65
  instrument pad  source=drone tone=soft   env=pad   level=100% space=hall
  instrument bell source=bell  tone=glassy env=pluck level=100% space=hall

song paper_lanterns
  meter 4/4
  bars 80
  feel straight
  space room

  # --- the hook, where a voice would be ---------------------------------
  staff lead instrument=lead level=56% pan=-15% humanize=light
    voice tune
      phrase REST
        | r1
        | r1
        | r1
        | r1
      phrase VERSE1
        | r2 f'4 g'4
        | a'2 g'4 f'4
        | e'2 g'4 e'4
        | d'1
      phrase VERSE2
        | r2 f'4 g'4
        | a'2 c''4 a'4
        | g'2 f'4 e'4
        | f'1
      phrase PRE
        | b'4 b'4 c''2
        | c''4 c''4 d''2
        | d''4 c''4 b'2
        | a'1
      phrase HOOK1
        | f'4 g'4 a'2
        | g'4 e'4 g'2
        | a'4 a'4 f'2
        | g'4 f'4 d'2
      phrase HOOK2
        | f'4 g'4 a'2
        | c''4 a'4 g'2
        | a'4 g'4 f'2
        | f'1
      phrase BRIDGE
        | d''2 a'2
        | c''2 e'2
        | d''2 f''2
        | e''1
      phrase HIGH1
        | f''4 g''4 a''2
        | g''4 e''4 g''2
        | a''4 a''4 f''2
        | g''4 f''4 d''2
      phrase HIGH2
        | f''4 g''4 a''2
        | c'''4 a''4 g''2
        | a''4 g''4 f''2
        | f''1
      dynamic mp
      play REST REST
      play VERSE1 VERSE2
      dynamic mf
      play PRE
      dynamic f
      play HOOK1 HOOK2
      dynamic mp
      play VERSE1 VERSE2
      dynamic mf
      play PRE
      dynamic f
      play HOOK1 HOOK2
      dynamic mf
      play BRIDGE BRIDGE
      dynamic p
      play REST
      dynamic ff
      play HIGH1 HIGH2 HOOK2
      dynamic mp
      play VERSE2 REST

  # --- chords, and they change with the section -------------------------
  staff keys instrument=keys level=46% pan=20% humanize=light
    voice chords
      phrase SPARSE
        | <f a c'>2 <f a c'>2
        | <c' e' g'>2 <c' e' g'>2
        | <d' f' a'>2 <d' f' a'>2
        | <b d' f'>2 <b d' f'>2
      phrase DRIVE
        | <f a c'>8 q q q q q q q
        | <c' e' g'>8 q q q q q q q
        | <d' f' a'>8 q q q q q q q
        | <b d' f'>8 q q q q q q q
      phrase PRE
        | <b d' f'>8 q q q q q q q
        | <c' e' g'>8 q q q q q q q
        | <d' f' a'>8 q q q q q q q
        | <d' f' a'>8 q q q <d' f' a'>4 r4
      phrase BRIDGE
        | <d' f' a'>2 <d' f' a'>2
        | <a c' e'>2 <a c' e'>2
        | <b d' f'>2 <b d' f'>2
        | <c' e' g'>2 <c' e' g'>2
      phrase DROP
        | <b d' f'>1
        | r1
        | <c' e' g'>1
        | r1
      dynamic mp
      play SPARSE SPARSE
      play SPARSE SPARSE
      dynamic mf
      play PRE
      dynamic f
      play DRIVE DRIVE
      dynamic mp
      play SPARSE SPARSE
      dynamic mf
      play PRE
      dynamic f
      play DRIVE DRIVE
      dynamic mf
      play BRIDGE BRIDGE
      dynamic p
      play DROP
      dynamic ff
      play DRIVE DRIVE DRIVE
      dynamic mp
      play SPARSE SPARSE

  staff pad instrument=pad level=22%
    voice hold
      phrase MAIN
        | <f a c'>1
        | <c' e' g'>1
        | <d' f' a'>1
        | <b d' f'>1
      phrase PRE
        | <b d' f'>1
        | <c' e' g'>1
        | <d' f' a'>1
        | <d' f' a'>1
      phrase BRIDGE
        | <d' f' a'>1
        | <a c' e'>1
        | <b d' f'>1
        | <c' e' g'>1
      dynamic p
      play MAIN MAIN MAIN MAIN
      play PRE
      dynamic mp
      play MAIN MAIN MAIN MAIN
      play PRE
      play MAIN MAIN
      dynamic mf
      play BRIDGE BRIDGE
      dynamic p
      play PRE
      dynamic mp
      play MAIN MAIN MAIN
      dynamic p
      play MAIN MAIN

  staff bass instrument=bass level=46%
    voice line
      phrase REST
        | r1
        | r1
        | r1
        | r1
      phrase ROOTS
        | f,4 r4 f,4 r4
        | c,4 r4 c,4 r4
        | d,4 r4 d,4 r4
        | b,,4 r4 b,,8 b,,8 r4
      phrase PRE
        | b,,4 r4 b,,4 r4
        | c,4 r4 c,4 r4
        | d,4 r4 d,4 r4
        | d,8 q q q d,8 q c,8 q
      phrase DRIVEN
        | f,8 q q q q q q q
        | c,8 q q q q q q q
        | d,8 q q q q q q q
        | b,,8 q q q b,,8 q c,8 q
      phrase BRIDGE
        | d,4 r4 d,4 r4
        | a,,4 r4 a,,4 r4
        | b,,4 r4 b,,4 r4
        | c,8 q q q c,8 q c,8 q
      phrase DROP
        | b,,1
        | r1
        | c,1
        | r1
      play REST
      dynamic mp
      play ROOTS
      dynamic mf
      play ROOTS ROOTS
      play PRE
      dynamic ff
      play DRIVEN DRIVEN
      dynamic mf
      play ROOTS ROOTS
      play PRE
      dynamic ff
      play DRIVEN DRIVEN
      dynamic mf
      play BRIDGE BRIDGE
      dynamic p
      play DROP
      dynamic ff
      play DRIVEN DRIVEN DRIVEN
      dynamic mp
      play ROOTS REST

  staff bell instrument=bell level=32% pan=30%
    voice sparkle
      phrase REST
        | r1
        | r1
        | r1
        | r1
      phrase SHINE
        | c'''1
        | r1
        | a''1
        | r1
      play REST REST REST REST REST
      dynamic mp
      play SHINE SHINE
      dynamic p
      play REST REST REST
      dynamic mf
      play SHINE SHINE
      dynamic p
      play REST REST REST
      dynamic ff
      play SHINE SHINE SHINE
      dynamic mp
      play SHINE REST

  # --- three voices, so a verse and a chorus are different things -------
  staff drum instrument=kit level=30%
    voice kick
      phrase REST
        | r1
        | r1
        | r1
        | r1
      phrase BACKBEAT
        | k4 r4 k4 r4
        | k4 r4 k4 r4
        | k4 r4 k4 r4
        | k4 r4 k8 k8 r4
      phrase FOUR
        | k4 k4 k4 k4
        | k4 k4 k4 k4
        | k4 k4 k4 k4
        | k4 k4 k8 k8 k4
      phrase DROP
        | k1
        | r1
        | k1
        | k4 k4 k4 k4
      play REST
      dynamic mf
      play BACKBEAT
      play BACKBEAT BACKBEAT
      play BACKBEAT
      dynamic ff
      play FOUR FOUR
      dynamic mf
      play BACKBEAT BACKBEAT
      play BACKBEAT
      dynamic ff
      play FOUR FOUR
      dynamic mf
      play BACKBEAT BACKBEAT
      dynamic p
      play DROP
      dynamic ff
      play FOUR FOUR FOUR
      dynamic mp
      play BACKBEAT REST

    voice snare
      phrase REST
        | r1
        | r1
        | r1
        | r1
      phrase BACK
        | r4 s4 r4 s4
        | r4 s4 r4 s4
        | r4 s4 r4 s4
        | r4 s4 r4 s8 s8
      phrase FILL
        | r4 s4 r4 s4
        | r4 s4 r4 s4
        | r4 s4 r4 s4
        | s8 s8 t8 t8 T8 T8 s8 c8
      play REST
      dynamic mf
      play BACK
      play BACK FILL
      play BACK
      dynamic ff
      play BACK FILL
      dynamic mf
      play BACK BACK
      play BACK
      dynamic ff
      play BACK FILL
      dynamic mf
      play BACK FILL
      dynamic p
      play REST
      dynamic ff
      play BACK BACK FILL
      dynamic mp
      play BACK REST

    voice hats
      phrase REST
        | r1
        | r1
        | r1
        | r1
      phrase CLOSED
        | h8 h8 h8 h8 h8 h8 h8 h8
        | h8 h8 h8 h8 h8 h8 h8 h8
        | h8 h8 h8 h8 h8 h8 h8 h8
        | h8 h8 h8 h8 h8 h8 h8 h8
      phrase OPEN
        | h8 H8 h8 H8 h8 H8 h8 H8
        | h8 H8 h8 H8 h8 H8 h8 H8
        | h8 H8 h8 H8 h8 H8 h8 H8
        | h8 H8 h8 H8 h8 h8 h8 h8
      dynamic mp
      play CLOSED
      dynamic mf
      play CLOSED CLOSED CLOSED
      play CLOSED
      dynamic ff
      play OPEN OPEN
      dynamic mf
      play CLOSED CLOSED
      play CLOSED
      dynamic ff
      play OPEN OPEN
      dynamic mf
      play CLOSED CLOSED
      dynamic p
      play REST
      dynamic ff
      play OPEN OPEN OPEN
      dynamic mp
      play CLOSED REST

  checks
    assert peak <= -1.0 db
    assert duration ~ 171 s
    assert centroid < 4000 hz
