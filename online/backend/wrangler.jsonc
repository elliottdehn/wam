/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wamshare",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-08",
	"migrations": [
		{
			"new_sqlite_classes": [
				"Registry"
			],
			"tag": "v1"
		}
	],
	"assets": {
		// Built by ../frontend (`npm run build` there writes straight into here),
		// so this directory is generated output, not hand-edited source.
		"directory": "./public",
		"binding": "ASSETS",
		// React owns client-side routing, so any path that isn't a real file has
		// to fall through to index.html instead of 404ing.
		"not_found_handling": "single-page-application",
		// ...which is exactly why this is needed too: with SPA fallback on, an
		// unmatched /api/* would be answered with index.html and never reach the
		// Worker. These prefixes hit the Worker before assets are consulted.
		"run_worker_first": [
			"/api/*"
		]
	},
	// One Durable Object holds the whole graph. The argument is serialisability,
	// not headroom: first-write-wins and parents-must-be-public are both
	// read-then-write races everywhere except inside a single DO.
	"durable_objects": {
		"bindings": [
			{
				"class_name": "Registry",
				"name": "REGISTRY"
			}
		]
	},
	// R2 holds the source and nothing else. Compiled output is never stored:
	// compilation is client side, and the browser caches its own renders.
	"r2_buckets": [
		{
			"binding": "SOURCES",
			"bucket_name": "wamshare-sources"
		},
		{
			"bucket_name": "wamshare-sources",
			"binding": "wamshare_sources"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}