# Worg — WoW-style wolf mount. Quadruped test of the language.
model wolf
  height 1.4
  style chunky

palette
  fur      #6f6a63
  fur_dark #4a453f
  belly    #a49c8f
  mane     #35302b
  claw     #2b2a26
  nose     #23201c
  eye      #d8b13c
  tongue   #a04a48

skeleton
  root withers at (0,0.57,0.30)
  bone spine1 parent=withers dir=back pitch=-4 len=0.28
  bone spine2 parent=spine1  dir=back pitch=6 len=0.24
  bone neck   parent=withers dir=fwd pitch=-38 len=0.17
  bone head   parent=neck    dir=fwd pitch=-6 len=0.15
  bone tail1  parent=spine2  dir=back pitch=35 len=0.16
  bone tail2  parent=tail1   dir=back pitch=-10 len=0.16
  mirror
    bone fleg_u parent=withers at=0.05 side=0.10 up=-0.04 dir=down pitch=6 len=0.24
    bone fleg_l parent=fleg_u dir=down pitch=-8 len=0.22
    bone fpaw   parent=fleg_l dir=fwd pitch=18 len=0.08
    bone hleg_u parent=spine2 at=0.85 side=0.10 up=-0.02 dir=down pitch=-24 len=0.22
    bone hleg_l parent=hleg_u dir=down pitch=30 len=0.16
    bone hleg_c parent=hleg_l dir=down pitch=-14 len=0.16
    bone hpaw   parent=hleg_c dir=fwd pitch=18 len=0.08
  end

parts
  loft body bones=spine1..spine2 material=fur
    ring 0.00 w=0.32 d=0.38
    ring 0.25 w=0.29 d=0.34
    ring 0.55 w=0.24 d=0.27
    ring 0.80 w=0.26 d=0.28
    ring 1.00 w=0.16 d=0.18
    cap start=flat end=dome

  loft chest bone=withers at=0.0 dir=fwd pitch=30 len=0.14 material=fur
    ring 0.00 w=0.31 d=0.36
    ring 1.00 w=0.19 d=0.22
    cap start=flat end=dome

  loft neckf bones=neck..neck material=mane
    ring 0.00 w=0.27 d=0.31
    ring 0.60 w=0.23 d=0.25
    ring 1.00 w=0.17 d=0.18
    cap start=flat end=flat

  loft skull bones=head..head material=fur
    ring 0.00 w=0.165 d=0.165
    ring 0.50 w=0.175 d=0.155
    ring 1.00 w=0.11 d=0.10
    cap start=dome end=flat

  loft muzzle bone=head at=0.95 offset=(0,-0.02,0) dir=fwd pitch=8 len=0.11 material=fur
    ring 0.00 w=0.095 d=0.082
    ring 0.70 w=0.078 d=0.066
    ring 1.00 w=0.050 d=0.042 material=nose
    cap start=none end=dome

  loft tail bones=tail1..tail2 material=fur
    ring 0.00 w=0.07 d=0.07
    ring 0.35 w=0.085 d=0.085
    ring 0.75 w=0.065 d=0.065 material=fur_dark
    ring 1.00 w=0.02 d=0.02 tip material=fur_dark
    cap start=flat end=none

  loft ridge bone=spine1 at=0.10 offset=(0,0.11,0) dir=back pitch=2 len=0.32 material=mane
    ring 0.00 w=0.17 d=0.12
    ring 0.45 w=0.14 d=0.10
    ring 1.00 w=0.05 d=0.04 tip
    cap start=dome end=none

  mirror
    loft ear bone=head at=0.30 offset=(0.055,0.055,0) dir=up pitch=-12 tilt=18 len=0.09 material=fur_dark
      ring 0.00 w=0.055 d=0.035
      ring 0.60 w=0.045 d=0.025
      ring 1.00 w=0.014 d=0.008 tip
      cap start=flat end=none

    attach eye_w bone=head kind=eye at=0.70 offset=(0.052,0.012,0.030) size=0.020 material=eye

    loft flegf bones=fleg_u..fleg_l material=fur
      ring 0.00 w=0.14 d=0.16
      ring 0.35 w=0.10 d=0.11
      ring 0.65 w=0.075 d=0.085
      ring 1.00 w=0.06 d=0.065
      cap start=dome end=flat

    attach fpaw_a bone=fpaw kind=hoof at=0.4 size=0.05 w=0.09 d=0.12 taper=1.05 material=fur_dark

    loft hlegf bones=hleg_u..hleg_c material=fur
      ring 0.00 w=0.16 d=0.21
      ring 0.30 w=0.12 d=0.16
      ring 0.55 w=0.08 d=0.09
      ring 0.80 w=0.065 d=0.07
      ring 1.00 w=0.055 d=0.06
      cap start=dome end=flat

    attach hpaw_a bone=hpaw kind=hoof at=0.4 size=0.05 w=0.09 d=0.12 taper=1.05 material=fur_dark
  end

animations
  anim idle loop dur=2.6
    ch tail1 yaw 0%=14 50%=-14 100%=14
    ch tail2 yaw 0%=20 25%=0 50%=-20 75%=0 100%=20
    ch head pitch 0%=0 40%=3 100%=0
    ch neck yaw 0%=2 55%=-2 100%=2

  anim trot loop dur=0.55
    ch fleg_u.l pitch 0%=-24 50%=20 100%=-24
    ch fleg_l.l pitch 0%=0 40%=8 60%=20 78%=42 100%=0
    ch hleg_u.l pitch 0%=18 50%=-20 100%=18
    ch hleg_l.l pitch 0%=6 22%=34 45%=8 100%=6
    ch spine1 pitch 0%=2 25%=-2 50%=2 75%=-2 100%=2
    ch neck pitch 0%=2 50%=-2 100%=2
    mirrorphase 50%
