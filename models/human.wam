# Human — WoW-style human male footman: plate, pauldrons, tabard.
model human
  height 1.85
  style chunky

palette
  skin     #c99b72
  skin_sh  #a87e5c
  hair     #4a3626
  steel    #97a0ab
  steel_dk #5f6774
  gold     #c9a24a
  tabard   #24407e
  cloth    #4f4438
  leather  #5a3d26
  boots    #46392c
  eye      #2e4a68
  steel_br #b6bec9
  cape     #7a2230

skeleton
  root pelvis at 0.53
  bone spine1 parent=pelvis dir=up pitch=2 len=0.125
  bone spine2 parent=spine1 dir=up pitch=-2 len=0.125
  bone neck   parent=spine2 dir=up pitch=3 len=0.04
  bone head   parent=neck   dir=up pitch=0 len=0.125
  mirror
    bone clavicle parent=spine2 dir=side tilt=-8 len=0.13
    bone upperarm parent=clavicle dir=down tilt=10 pitch=-4 len=0.165
    bone forearm  parent=upperarm dir=down tilt=3 pitch=-10 len=0.14
    bone hand     parent=forearm  dir=down tilt=2 pitch=-4 len=0.095
    bone thigh    parent=pelvis side=0.062 dir=down tilt=3 pitch=-3 len=0.24
    bone shin     parent=thigh  dir=down pitch=7 len=0.215
    bone foot     parent=shin   dir=fwd pitch=22 len=0.10
  end

parts
  loft torso bones=pelvis..neck material=steel
    ring 0.00 w=0.225 d=0.160 material=leather
    ring 0.13 w=0.215 d=0.150 material=gold
    ring 0.20 w=0.210 d=0.145
    ring 0.55 w=0.270 d=0.175
    ring 0.60 w=0.278 d=0.177 material=gold
    ring 0.66 w=0.288 d=0.180
    ring 0.76 w=0.305 d=0.185
    ring 0.86 w=0.210 d=0.140 material=steel_dk
    ring 0.94 w=0.130 d=0.105 material=steel_dk
    ring 1.00 w=0.085 d=0.085 material=skin
    cap start=dome end=flat

  loft skull bones=head..head material=skin
    ring 0.00 w=0.088 d=0.092
    ring 0.18 w=0.100 d=0.108
    ring 0.55 w=0.116 d=0.126
    ring 0.76 w=0.114 d=0.123
    ring 0.80 w=0.119 d=0.128 material=gold
    ring 0.86 w=0.112 d=0.120 material=hair
    ring 1.00 w=0.086 d=0.096 material=hair
    cap start=none end=dome

  loft nose bone=head at=0.41 offset=(0,0,0.054) dir=fwd pitch=22 len=0.018 material=skin_sh
    ring 0.00 w=0.020 d=0.022
    ring 1.00 w=0.013 d=0.013
    cap start=none end=dome

  loft hairback bone=head at=0.85 offset=(0,0,-0.045) dir=down pitch=-12 len=0.09 material=hair
    ring 0.00 w=0.105 d=0.05
    ring 0.60 w=0.085 d=0.04
    ring 1.00 w=0.045 d=0.02
    cap start=none end=flat

  loft tabard_f bone=spine2 at=0 offset=(0,-0.010,0.080) dir=down len=0.33 material=tabard shape=box
    ring 0.00 w=0.135 d=0.020
    ring 0.55 w=0.125 d=0.016 follow=thigh:0.45
    ring 0.85 w=0.120 d=0.014 material=gold follow=thigh:0.75
    ring 1.00 w=0.115 d=0.012 follow=thigh:0.85
    cap start=flat end=flat

  loft cape bone=spine2 at=0.85 offset=(0,0,-0.105) dir=down pitch=4 len=0.52 material=cape shape=box
    ring 0.00 w=0.24 d=0.025
    ring 0.35 w=0.27 d=0.020
    ring 0.75 w=0.29 d=0.016 follow=thigh:0.35
    ring 1.00 w=0.30 d=0.014 material=gold follow=thigh:0.5
    cap start=flat end=flat

  loft blade bone=hand.r at=1.0 offset=(0,0.005,0.035) dir=down pitch=-40 len=0.34 material=steel_br shape=box
    ring 0.00 w=0.012 d=0.042
    ring 0.80 w=0.010 d=0.035
    ring 1.00 w=0.004 d=0.008 tip
    cap start=flat end=none

  loft crossguard bone=hand.r at=1.0 offset=(0,-0.039,-0.017) dir=fwd pitch=-40 len=0.136 material=gold shape=box
    ring 0.00 w=0.024 d=0.046
    ring 0.50 w=0.028 d=0.052
    ring 1.00 w=0.024 d=0.046
    cap start=dome end=dome

  loft grip bone=hand.r at=1.0 offset=(0,0.005,0.035) dir=up pitch=-40 len=0.105 material=leather
    ring 0.00 w=0.024 d=0.024
    ring 1.00 w=0.022 d=0.022
    cap start=none end=flat

  attach pommel bone=hand.r kind=sphere at=1.0 offset=(0,0.085,-0.032) size=0.036 material=gold

  attach shield bone=forearm.l kind=hoof at=0.4 offset=(0.058,0.02,0.008) size=0.1 w=0.032 h=0.34 d=0.28 taper=0.62 material=steel_dk
  attach boss bone=forearm.l kind=sphere at=0.4 offset=(0.082,-0.13,0.008) size=0.055 material=gold

  mirror
    attach eye_h bone=head kind=eye at=0.52 offset=(0.032,0,0.048) size=0.015 material=eye

    loft ear_h bone=head at=0.38 offset=(0.056,0,-0.008) dir=side len=0.014 on=skull inset=0.008 material=skin_sh
      ring 0.00 w=0.024 d=0.018
      ring 1.00 w=0.016 d=0.012
      cap start=none end=dome

    attach pauldron bone=clavicle kind=sphere at=1.0 offset=(0.008,0.022,0) size=0.13 w=0.145 h=0.10 d=0.16 material=steel

    sweep pspike bone=clavicle at=1.0 offset=(0.03,0.08,0) dir=up tilt=-28 on=pauldron material=gold
      seg len=0.04 r=0.019 curl=10
      seg len=0.035 r=0.012 curl=22
      seg len=0.03 r=0.005 curl=28 tip

    loft arm bones=upperarm..forearm material=steel_dk
      ring 0.00 w=0.100 d=0.100
      ring 0.30 w=0.082 d=0.082
      ring 0.48 w=0.075 d=0.075
      ring 0.58 w=0.108 d=0.108 material=gold
      ring 0.66 w=0.100 d=0.100 material=steel
      ring 0.85 w=0.095 d=0.095 material=steel
      ring 1.00 w=0.080 d=0.080 material=steel
      cap start=dome end=flat

    loft fist bones=hand..hand material=steel
      ring 0.00 w=0.062 d=0.048
      ring 1.00 w=0.050 d=0.040
      cap start=none end=dome

    loft leg bones=thigh..shin material=cloth
      ring 0.00 w=0.120 d=0.130
      ring 0.30 w=0.100 d=0.110
      ring 0.50 w=0.085 d=0.092 material=boots
      ring 0.62 w=0.102 d=0.108 material=gold
      ring 0.70 w=0.088 d=0.094 material=steel
      ring 0.85 w=0.078 d=0.084 material=steel
      ring 1.00 w=0.068 d=0.074 material=steel
      cap start=flat end=flat

    attach boot bone=foot kind=hoof at=0.3 size=0.05 w=0.085 d=0.15 taper=1.0 material=steel_dk
  end

animations
  pose breathe
    spine2 pitch=1.5
    clavicle.* roll=1.5

  anim idle loop dur=3.2
    key 0% pose=rest
    key 50% pose=breathe
    key 100% pose=rest

  anim walk loop dur=1.05
    ch thigh.l pitch 0%=-24 50%=20 100%=-24
    ch shin.l pitch 0%=4 40%=12 55%=24 75%=48 100%=4
    ch foot.l pitch 0%=-6 50%=8 75%=-18 100%=-6
    ch upperarm.l pitch 0%=16 50%=-14 100%=16
    ch forearm.l pitch 0%=2 50%=-14 100%=2
    ch spine1 roll 0%=2 50%=-2 100%=2
    ch spine2 yaw 0%=-3 50%=3 100%=-3
    mirrorphase 50%

  anim run loop dur=0.62
    ch thigh.l pitch 0%=-40 50%=28 100%=-40
    ch shin.l pitch 0%=8 40%=18 60%=42 78%=72 100%=8
    ch foot.l pitch 0%=-4 50%=10 75%=-22 100%=-4
    ch upperarm.l pitch 0%=28 50%=-26 100%=28
    ch forearm.l pitch 0%=-30 50%=-44 100%=-30
    ch spine1 pitch 0%=7 25%=9 50%=7 75%=9 100%=7
    ch spine1 roll 0%=3 50%=-3 100%=3
    mirrorphase 50%

  pose stagger
    spine1 pitch=-7
    head pitch=-12
    upperarm.* pitch=-30
    forearm.* pitch=-18

  pose fallen
    pelvis pitch=-82
    thigh.* pitch=20
    shin.* pitch=-26
    upperarm.* pitch=-25
    head pitch=-20

  anim death dur=1.3
    key 0% pose=rest
    key 25% pose=stagger
    key 65% pose=fallen
    key 100% pose=fallen

  anim attack dur=0.85
    ch spine2 yaw 0%=12 35%=16 60%=-22 100%=0
    ch spine1 yaw 0%=5 35%=7 60%=-10 100%=0
    ch clavicle.r pitch 0%=0 35%=-16 60%=8 100%=0
    ch upperarm.r pitch 0%=8 35%=-140 60%=30 100%=0
    ch upperarm.r yaw 0%=0 35%=-20 60%=8 100%=0
    ch forearm.r pitch 0%=-6 35%=-35 60%=-4 100%=-6
    ch upperarm.l pitch 0%=0 35%=20 60%=-12 100%=0
    ch head yaw 0%=5 35%=8 60%=-8 100%=0

  anim victory dur=1.6
    ch upperarm.r pitch 0%=0 25%=-155 60%=-155 100%=0
    ch upperarm.r yaw 0%=0 25%=-10 60%=-10 100%=0
    ch forearm.r pitch 0%=0 25%=-12 60%=-12 100%=0
    ch spine1 pitch 0%=0 25%=-5 60%=-5 100%=0
    ch head pitch 0%=0 25%=-10 60%=-10 100%=0
    ch upperarm.l pitch 0%=0 25%=12 60%=12 100%=0
