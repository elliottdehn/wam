# Burial mound ringed with stones, marker stone on top.
model mound
  height 2.2
  style smooth

palette
  earth #6b6b3f
  stone #8a8578

textures
  texture earth base=#6b6b3f
    noise scale=0.5 amount=0.10
    gradient axis=v from=-0.08 to=0.10
  texture stone base=#8a8578
    noise scale=0.3 amount=0.10

skeleton
  root base at 0
  bone core parent=base dir=up len=1.0

parts
  loft dome bones=core..core material=earth
    ring 0.00 w=2.6 d=2.2
    ring 0.45 w=2.1 d=1.8
    ring 0.80 w=1.2 d=1.0
    ring 1.00 w=0.4 d=0.35 tip
    cap start=flat end=none

  attach s1 bone=core kind=sphere at=0.08 offset=(1.15,0,0.3) w=0.32 h=0.26 d=0.28 material=stone
  attach s2 bone=core kind=sphere at=0.08 offset=(0.5,0,-1.05) w=0.30 h=0.24 d=0.28 material=stone
  attach s3 bone=core kind=sphere at=0.08 offset=(-0.85,0,-0.6) w=0.28 h=0.22 d=0.26 material=stone
  attach s4 bone=core kind=sphere at=0.08 offset=(-0.9,0,0.65) w=0.30 h=0.24 d=0.26 material=stone
  attach s5 bone=core kind=sphere at=0.08 offset=(0.15,0,1.1) w=0.28 h=0.22 d=0.26 material=stone
  attach marker bone=core kind=box at=0.92 offset=(0,0,0) w=0.18 h=0.55 d=0.10 material=stone
