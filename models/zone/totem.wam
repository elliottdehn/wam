# Carved camp totem with painted bands and wing boards.
model totem
  height 7.5
  style chunky

palette
  wood  #6e5238
  red   #a4543c
  blue  #3c5c7a
  bone2 #d8ccb0

textures
  texture wood base=#6e5238
    streaks along=v amount=0.12 scale=1.4
    band axis=v at=0.18 width=0.08 color=#a4543c
    band axis=v at=0.44 width=0.06 color=#3c5c7a
    band axis=v at=0.70 width=0.08 color=#a4543c
    gradient axis=v from=-0.08 to=0.08

skeleton
  root base at 0
  bone core parent=base dir=up len=1.0

parts
  loft pole bones=core..core material=wood shape=squarish
    ring 0.00 w=0.16 d=0.16
    ring 0.75 w=0.13 d=0.13
    ring 0.78 w=0.17 d=0.17
    ring 0.94 w=0.15 d=0.15
    ring 1.00 w=0.10 d=0.10
    cap start=flat end=flat

  attach wing1 bone=core kind=box at=0.86 offset=(0.20,0,0) w=0.26 h=0.05 d=0.02 material=bone2
  attach wing2 bone=core kind=box at=0.86 offset=(-0.20,0,0) w=0.26 h=0.05 d=0.02 material=bone2
  attach cap bone=core kind=hoof at=1.0 offset=(0,0,0) w=0.20 h=0.06 d=0.20 taper=0.5 material=bone2
