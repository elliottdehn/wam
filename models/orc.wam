# Orc grunt — Horde warrior to fight the human. Hunched, tusked, one
# spiked pauldron, two-handed axe. Uses on=, follow=, tilt channels.
model orc
  height 2.1
  style chunky

palette
  skin     #6d8f4c
  skin_dk  #52713a
  tusk     #ddd2b8
  hair     #26201a
  leather  #5a3d26
  iron     #6e6a66
  iron_dk  #45423f
  cloth    #7a2a20
  eye      #cf3b2a
  gold     #c9a24a

skeleton
  root pelvis at 0.485
  bone spine1 parent=pelvis dir=up pitch=13 len=0.13
  bone spine2 parent=spine1 dir=up pitch=24 len=0.13
  bone neck   parent=spine2 dir=fwd pitch=-38 len=0.09
  bone head   parent=neck   dir=fwd pitch=-22 len=0.11
  bone jaw    parent=head at=0.72 offset=(0,-0.05,0.01) dir=fwd pitch=8 len=0.10
  mirror
    bone clavicle parent=spine2 dir=side tilt=-9 len=0.17
    bone upperarm parent=clavicle dir=down tilt=13 pitch=-4 len=0.21
    bone forearm  parent=upperarm dir=down tilt=4 pitch=-13 len=0.19
    bone hand     parent=forearm dir=down tilt=2 pitch=-6 len=0.09
    bone thigh    parent=pelvis side=0.07 dir=down tilt=3 pitch=-8 len=0.22
    bone shin     parent=thigh dir=down pitch=10 len=0.20
    bone foot     parent=shin dir=fwd pitch=22 len=0.10
  end

parts
  loft torso bones=pelvis..spine2 material=skin
    ring 0.00 w=0.25 d=0.185 material=cloth
    ring 0.13 w=0.245 d=0.180 material=leather
    ring 0.22 w=0.24 d=0.175
    ring 0.55 w=0.28 d=0.215 fwd=0.012
    ring 0.80 w=0.315 d=0.225
    ring 0.93 w=0.30 d=0.21
    ring 1.00 w=0.26 d=0.19
    cap start=dome end=dome

  loft neckm bones=neck..neck material=skin
    ring 0.00 w=0.15 d=0.14
    ring 1.00 w=0.125 d=0.115
    cap start=flat end=flat

  loft skull bones=head..head material=skin
    ring 0.00 w=0.145 d=0.155
    ring 0.45 w=0.165 d=0.165
    ring 0.75 w=0.170 d=0.155 up=0.006
    ring 1.00 w=0.125 d=0.115
    cap start=dome end=flat

  loft jawm bones=jaw..jaw material=skin
    ring 0.00 w=0.125 d=0.075
    ring 0.65 w=0.130 d=0.065
    ring 1.00 w=0.105 d=0.050
    cap start=none end=flat

  loft nose bone=head at=0.92 offset=(0,-0.005,0.05) dir=fwd pitch=30 len=0.022 on=skull material=skin_dk
    ring 0.00 w=0.045 d=0.028
    ring 1.00 w=0.032 d=0.018
    cap start=none end=dome

  loft loincloth bone=pelvis at=0 offset=(0,0.05,0) dir=down len=0.18 material=cloth shape=squarish
    ring 0.00 w=0.31 d=0.22
    ring 0.55 w=0.30 d=0.215 follow=thigh:0.5
    ring 1.00 w=0.33 d=0.235 follow=thigh:0.8
    cap start=none end=flat

  mirror
    sweep tusk bone=jaw at=0.90 offset=(0.042,0.012,0) dir=up pitch=6 on=jawm inset=0.022 material=tusk
      seg len=0.04 r=0.019 curl=12
      seg len=0.035 r=0.012 curl=20
      seg len=0.03 r=0.005 curl=22 tip

    loft ear_o bone=head at=0.30 offset=(0.085,0.01,0) dir=side yaw=32 tilt=8 len=0.07 on=skull inset=0.01 material=skin
      ring 0.00 w=0.040 d=0.016
      ring 0.55 w=0.032 d=0.012
      ring 1.00 w=0.008 d=0.005 tip
      cap start=none end=none

    attach eye_o bone=head kind=eye at=0.80 offset=(0.050,0.012,0.050) size=0.021 on=skull inset=0.007 material=eye

    loft arm bones=upperarm..hand material=skin
      ring 0.00 w=0.125 d=0.125
      ring 0.30 w=0.105 d=0.105
      ring 0.55 w=0.10 d=0.10
      ring 0.72 w=0.105 d=0.105 material=leather
      ring 0.88 w=0.09 d=0.09 material=leather
      ring 1.00 w=0.075 d=0.065
      cap start=dome end=dome

    loft leg bones=thigh..shin material=skin
      ring 0.00 w=0.135 d=0.15
      ring 0.35 w=0.115 d=0.125
      ring 0.60 w=0.095 d=0.10
      ring 0.75 w=0.10 d=0.105 material=leather
      ring 1.00 w=0.08 d=0.085 material=leather
      cap start=flat end=flat

    attach boot bone=foot kind=hoof at=0.35 size=0.05 w=0.085 d=0.14 taper=1.05 material=leather
  end

  # one-shoulder spiked pauldron (left only — grunt asymmetry)
  attach pauldron bone=clavicle.l kind=sphere at=1.0 offset=(0.012,0.03,0) size=0.13 w=0.15 h=0.105 d=0.165 material=iron

  sweep pspike1 bone=clavicle.l at=1.0 offset=(0.04,0.09,0) dir=up tilt=-30 on=pauldron material=iron_dk
    seg len=0.045 r=0.02 curl=8
    seg len=0.04 r=0.012 curl=15
    seg len=0.035 r=0.005 curl=20 tip
  sweep pspike2 bone=clavicle.l at=1.0 offset=(-0.01,0.09,0.03) dir=up pitch=-18 on=pauldron material=iron_dk
    seg len=0.04 r=0.016 curl=6
    seg len=0.035 r=0.009 curl=12
    seg len=0.03 r=0.004 curl=16 tip
  sweep pspike3 bone=clavicle.l at=1.0 offset=(0.02,0.08,-0.04) dir=up pitch=14 tilt=-14 on=pauldron material=iron_dk
    seg len=0.04 r=0.015 curl=-6
    seg len=0.03 r=0.008 curl=-10
    seg len=0.025 r=0.004 curl=-12 tip

  # axe: butt in the fist, haft rising 45 deg, blade at the top facing down
  group axe bone=hand.r at=1.0 dir=up pitch=45 yaw=-15
    loft haft at=(0,-0.03,0) dir=up len=0.47 material=leather
      ring 0.00 w=0.026 d=0.026
      ring 1.00 w=0.022 d=0.022
      cap start=dome end=dome

    loft blade at=(0,0.40,0) dir=fwd len=0.15 material=iron shape=box
      ring 0.00 w=0.036 d=0.15
      ring 0.50 w=0.024 d=0.20
      ring 1.00 w=0.012 d=0.25
      cap start=flat end=flat

    sweep bspike at=(0,0.40,0) dir=back material=iron
      seg len=0.045 r=0.015
      seg len=0.035 r=0.008 curl=6
      seg len=0.03 r=0.004 curl=8 tip
  end

animations
  anim idle loop dur=3.4
    ch spine2 pitch 0%=1.8 50%=-1.8 100%=1.8
    ch clavicle.l roll 0%=2 50%=-2 100%=2
    ch head yaw 0%=2 40%=-3 100%=2
    mirrorphase 50%

  anim walk loop dur=1.15
    ch thigh.l pitch 0%=-22 50%=19 100%=-22
    ch shin.l pitch 0%=5 40%=13 55%=25 75%=45 100%=5
    ch foot.l pitch 0%=-6 50%=8 75%=-16 100%=-6
    ch upperarm.l pitch 0%=17 50%=-15 100%=17
    ch upperarm.r pitch 0%=-8 50%=8 100%=-8
    ch spine1 roll 0%=4 50%=-4 100%=4
    ch spine2 yaw 0%=-4 50%=4 100%=-4
    mirrorphase 50%

  anim run loop dur=0.68
    ch thigh.l pitch 0%=-38 50%=27 100%=-38
    ch shin.l pitch 0%=8 40%=17 60%=40 78%=68 100%=8
    ch foot.l pitch 0%=-4 50%=10 75%=-20 100%=-4
    ch upperarm.l pitch 0%=26 50%=-24 100%=26
    ch upperarm.r pitch 0%=-12 50%=12 100%=-12
    ch spine1 pitch 0%=8 25%=10 50%=8 75%=10 100%=8
    ch spine1 roll 0%=4 50%=-4 100%=4
    mirrorphase 50%

  anim attack dur=1.0
    ch spine2 yaw 0%=10 30%=16 60%=-24 100%=0
    ch spine1 yaw 0%=4 30%=7 60%=-12 100%=0
    ch spine1 pitch 0%=0 30%=-8 60%=12 100%=0
    ch clavicle.r pitch 0%=0 30%=-18 60%=8 100%=0
    ch upperarm.r pitch 0%=6 30%=-155 60%=30 100%=0
    ch upperarm.r yaw 0%=0 30%=-18 60%=8 100%=0
    ch forearm.r pitch 0%=-8 30%=-35 60%=-4 100%=-8
    ch upperarm.l pitch 0%=0 30%=-120 60%=20 100%=0
    ch forearm.l pitch 0%=-6 30%=-40 60%=-6 100%=-6
    ch shin.* pitch 0%=0 55%=12 75%=8 100%=0
    ch thigh.* pitch 0%=0 55%=-10 75%=-6 100%=0

  anim roar dur=1.5
    ch spine1 pitch 0%=0 30%=-10 70%=-10 100%=0
    ch spine2 pitch 0%=0 30%=-12 70%=-12 100%=0
    ch head pitch 0%=0 30%=-16 70%=-16 100%=0
    ch jaw pitch 0%=0 30%=22 70%=22 100%=0
    ch upperarm.l tilt 0%=0 30%=32 70%=32 100%=0
    ch upperarm.l pitch 0%=0 30%=-18 70%=-18 100%=0
    ch forearm.l pitch 0%=0 30%=-30 70%=-30 100%=0
    mirrorphase 0%

  pose stagger
    spine1 pitch=-7
    head pitch=-10
    upperarm.* pitch=-25

  pose fallen
    pelvis pitch=-80
    thigh.* pitch=22
    shin.* pitch=-28
    upperarm.* pitch=-28
    head pitch=-18

  anim death dur=1.4
    key 0% pose=rest
    key 25% pose=stagger
    key 62% pose=fallen
    key 100% pose=fallen
