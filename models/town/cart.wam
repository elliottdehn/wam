# Wooden hand cart with two spoked-look wheels and a hay load.
model cart
  height 1.7
  style smooth

palette
  wood  #6e5238
  wood2 #5a4230
  iron  #45423e
  hay   #c9a24a

textures
  texture wood base=#6e5238
    streaks along=v amount=0.13 scale=1.4
    noise scale=0.06 amount=0.05
  texture wood2 base=#5a4230
    streaks along=u amount=0.12 scale=1.4
  texture hay base=#c9a24a
    streaks along=v amount=0.14 scale=2.2
    gradient axis=v from=-0.12 to=0.10
    noise scale=0.05 amount=0.08

skeleton
  root base at 0
  bone core parent=base dir=up len=1.0

parts
  loft bed bone=core at=0.42 offset=(0,0,-0.55) dir=fwd len=1.10 material=wood shape=box
    ring 0.00 w=0.62 d=0.09
    ring 1.00 w=0.58 d=0.09
    cap start=flat end=flat

  attach side1 bone=core kind=box at=0.56 offset=(0.30,0,0) w=0.04 h=0.14 d=1.05 material=wood2
  attach side2 bone=core kind=box at=0.56 offset=(-0.30,0,0) w=0.04 h=0.14 d=1.05 material=wood2
  attach gate_b bone=core kind=box at=0.56 offset=(0,0,-0.53) w=0.58 h=0.14 d=0.04 material=wood2

  loft wheel1 bone=core at=0.30 offset=(0.33,0,0) dir=side len=0.06 material=wood2
    ring 0.00 w=0.60 d=0.60
    ring 1.00 w=0.60 d=0.60
    cap start=flat end=flat
  attach hub1 bone=core kind=sphere at=0.30 offset=(0.37,0,0) size=0.09 material=iron

  loft wheel2 bone=core at=0.30 offset=(-0.39,0,0) dir=side len=0.06 material=wood2
    ring 0.00 w=0.60 d=0.60
    ring 1.00 w=0.60 d=0.60
    cap start=flat end=flat
  attach hub2 bone=core kind=sphere at=0.30 offset=(-0.37,0,0) size=0.09 material=iron

  loft shaft1 bone=core at=0.40 offset=(0.22,0,0.52) dir=fwd pitch=8 len=0.45 material=wood
    ring 0.00 w=0.05 d=0.05
    ring 1.00 w=0.04 d=0.04
    cap start=none end=dome

  loft shaft2 bone=core at=0.40 offset=(-0.22,0,0.52) dir=fwd pitch=8 len=0.45 material=wood
    ring 0.00 w=0.05 d=0.05
    ring 1.00 w=0.04 d=0.04
    cap start=none end=dome

  loft hayload bone=core at=0.48 dir=up len=0.34 material=hay
    ring 0.00 w=0.55 d=0.95
    ring 0.55 w=0.44 d=0.80
    ring 1.00 w=0.20 d=0.42
    cap start=flat end=dome
